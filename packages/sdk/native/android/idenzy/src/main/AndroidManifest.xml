<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Custom Tabs resolve against whichever browser offers the service. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <!-- Holds the OAuth flow while the browser is in front; never shown, never exported. -->
        <activity
            android:name="io.idenzy.OAuthActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Catches the return on the app's redirect scheme and hands it to the activity above. -->
        <activity
            android:name="io.idenzy.OAuthRedirectActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${idenzyRedirectScheme}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
