# Copy this to .env and fill in your own project's values.
# Safe in a browser bundle. The secret key is not: keep that on a server.
PUBLIC_IDENZY_PUBLISHABLE_KEY=pk_replace_me
# Your auth domain. Cookie mode needs one that is same-site with your app.
PUBLIC_IDENZY_API_URL=https://auth.idenzy.io
# Server-side only. The audience every token for this project carries.
IDENZY_PROJECT_ID=
