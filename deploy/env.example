# The production VPS's deploy/.env (docs/guide/deploy.md). No secret is written in this file:
# every credential is a `secret://` reference the services resolve from Secret Manager at boot,
# and the stores' own passwords are files under deploy/secrets.

# --- Compose ----------------------------------------------------------------------------------
# The image the deploy workflow pushed, by digest: ghcr.io/<owner>/idenzy@sha256:…
IDENZY_IMAGE=
DOMAIN=idenzy.io
ACME_EMAIL=
# terraform output backup_bucket
BACKUP_BUCKET=

# --- The services ------------------------------------------------------------------------------
IDENZY_ENV=production
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3001
PORT=3000
# One proxy in front: Caddy. Its address is the last hop, the client's the one before it.
TRUSTED_PROXY_HOPS=1

ISSUER_BASE_URL=https://api.idenzy.io
DASHBOARD_ORIGIN=https://app.idenzy.io
DASHBOARD_AUTH_DOMAIN=auth.idenzy.io
OPERATOR_ORIGIN=https://console.idenzy.io
# Printed by `docker compose run --rm bootstrap platform`
DASHBOARD_PROJECT_ID=
OPERATOR_PROJECT_ID=

# Google: the Cloud project, and the KMS key every other key is wrapped by
GCP_PROJECT_ID=
# terraform output kms_key_name
KMS_KEY_NAME=
FIELD_KEY_WRAPPED=secret://idenzy-field-key

DATABASE_URL=secret://idenzy-database-url
DATABASE_MIGRATION_URL=secret://idenzy-database-migration-url
VALKEY_URL=secret://idenzy-valkey-url

# Email: Amazon SES (docs/guide/deploy.md has the domain and sandbox steps)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=secret://idenzy-aws-secret-access-key
SES_CONFIGURATION_SET=
SES_EVENT_URL=https://events.idenzy.io/ses
SES_EVENT_TOPIC_ARN=

# The operator console's Google client (ADR-0018); redirect URI
# https://api.idenzy.io/v1/auth/oauth/google/callback. Every `secret://` line above and below must
# have a value in Secret Manager before the services start, so these stay commented out until the
# client exists; then run `docker compose run --rm bootstrap platform` again.
# OPERATOR_GOOGLE_CLIENT_ID=
# OPERATOR_GOOGLE_CLIENT_SECRET=secret://idenzy-operator-google-client-secret

# Analytics (ClickHouse, `--profile analytics`). Leave every CLICKHOUSE_ line unset to run without.
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_DATABASE=idenzy
# CLICKHOUSE_USER=idenzy_app
# CLICKHOUSE_PASSWORD=secret://idenzy-clickhouse-password
# CLICKHOUSE_INGEST_USER=idenzy_ingest
# CLICKHOUSE_INGEST_PASSWORD=secret://idenzy-clickhouse-ingest-password
# CLICKHOUSE_OWNER_USER=idenzy_owner
# CLICKHOUSE_OWNER_PASSWORD=secret://idenzy-clickhouse-owner-password
# CLICKHOUSE_ERASER_USER=idenzy_eraser
# CLICKHOUSE_ERASER_PASSWORD=secret://idenzy-clickhouse-eraser-password
