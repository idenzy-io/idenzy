{
  "name": "@idenzy/svelte",
  "version": "0.2.0",
  "description": "Svelte and SvelteKit bindings for Idenzy: stores for the session and a server hook.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "svelte",
    "sveltekit",
    "ssr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/svelte"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-svelte.d.ts",
      "default": "./dist/idenzy-svelte.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/node": "workspace:*",
    "@idenzy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@idenzy/sdk-conformance": "workspace:*",
    "jose": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
