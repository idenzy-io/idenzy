{
  "name": "@idenzy/node",
  "version": "0.2.0",
  "description": "Verify Idenzy access tokens and webhooks on a server, offline, with an optional revocation set.",
  "keywords": [
    "idenzy",
    "auth",
    "jwt",
    "jwks",
    "webhooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/server/node"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-node.d.ts",
      "default": "./dist/idenzy-node.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@idenzy/core": "workspace:*",
    "@idenzy/protocol": "workspace:*",
    "jose": "catalog:sdk"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
