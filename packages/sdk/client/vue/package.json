{
  "name": "@idenzy/vue",
  "version": "0.1.0",
  "description": "Vue bindings for Idenzy: a plugin and useSession, useUser and useIdenzy.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/vue"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-vue.d.ts",
      "default": "./dist/idenzy-vue.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@idenzy/sdk-conformance": "workspace:*",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
