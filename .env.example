# Copy to .env for local development. The apps load it with --env-file-if-exists, so a
# missing file is not an error; a missing *variable* is, because @idenzy/config parses
# the environment once at boot and refuses to start on a bad one.
#
# Nothing here is a secret. In staging and production these come from Secret Manager.

IDENZY_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# One port per service, because they run side by side and cookie mode needs the panel and
# the auth API to be same-site. On a laptop that is localhost, which ignores the port for
# cookie purposes, so `__Host-` cookies set by 3001 reach a page served from 3000. In
# production these are subdomains of one site: app.idenzy.dev, auth.idenzy.dev,
# api.idenzy.dev (PROJECT.md 4.3).
#
# `PORT` is what each service reads; the three below are what `pnpm dev` gives them.
AUTH_API_PORT=3001
MANAGEMENT_API_PORT=3002
WORKERS_PORT=3003

# Matches infra/docker/postgres-init and docker-compose.yml.
DATABASE_URL=postgres://idenzy:idenzy@localhost:5432/idenzy
VALKEY_URL=redis://localhost:6379

# The analytics store (ADR-0013). Two identities, as Postgres has: the runtime one carries the
# row policies and the owner runs DDL. A deployment without these runs without analytics rather
# than failing, because nothing on the authentication path reads them.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=idenzy
CLICKHOUSE_USER=idenzy_app
CLICKHOUSE_INGEST_USER=idenzy_ingest
CLICKHOUSE_OWNER_USER=idenzy_owner
CLICKHOUSE_PASSWORD=idenzy

CELL_CODE=eu-1
KMS_KEY_RING=local-dev

# The `iss` claim and the base of the discovery document. Required, and deliberately not
# defaulted: a wrong issuer is accepted by every verifier told to expect it and rejected
# by every verifier that was not.
ISSUER_BASE_URL=http://localhost:3001

# Transactional email. Everything else about delivery has a working default; this is the
# envelope sender, and in development nothing is actually sent: LoggingEmailProvider
# prints the whole message, one-time code included, and refuses to exist anywhere else.
EMAIL_FROM_ADDRESS=no-reply@idenzy.dev

# The project our own dashboard signs in through: we run the panel on our own product
# (PROJECT.md 9.5), so a dashboard token is an ordinary Idenzy token and this is its `aud`.
# `pnpm db:seed` creates it with this fixed development id; production generates one.
DASHBOARD_PROJECT_ID=prj_00000000000040008000000000000002

# What the panel itself needs. Both are public by construction: a publishable key is meant
# to sit in a browser bundle, and the auth API's URL is printed in every token we sign.
# `NUXT_PUBLIC_` is how Nuxt overrides `runtimeConfig.public` from the environment.
#
# The key is minted once by `pnpm db:seed`, which prints it and cannot print it again —
# only its hash is stored. Paste it here.
NUXT_PUBLIC_IDENZY_PUBLISHABLE_KEY=
NUXT_PUBLIC_IDENZY_API_URL=http://localhost:3001

# Where the panel asks for its own data: organisations, projects, billing. Its own key
# rather than part of the SDK's block, because the SDK never talks to this service.
#
# The name has to spell the key it overrides: this one is `runtimeConfig.public`'s own
# `managementApiUrl` and not part of the module's `idenzy` block, so an
# `NUXT_PUBLIC_IDENZY_MANAGEMENT_URL` names nothing and is ignored in silence — a deployment
# that set it would keep the localhost default and look like it had been configured.
NUXT_PUBLIC_MANAGEMENT_API_URL=http://localhost:3002

# The only origin management-api answers a browser at. Loopback is allowed in development
# by the CORS policy itself, so this is the production value even on a laptop.
DASHBOARD_ORIGIN=https://app.idenzy.dev

# The webhook retry lane (ADR-0012). Commented out because a developer machine has no queue
# and does not need one: with these unset the worker sweeps the delivery table on its own
# interval, which is what actually guarantees a retry — Cloud Tasks only makes it punctual.
# Set all five or none; four of them is a boot failure rather than a silent fallback.
#
# The values come from `terraform output` (see infra/terraform/README.md).
# GCP_PROJECT_ID=idenzy-dev
# WEBHOOK_TASKS_LOCATION=europe-west4
# WEBHOOK_TASKS_QUEUE_PREFIX=idenzy-eu-1-webhooks
# WEBHOOK_TASKS_QUEUE_SHARDS=8
# WEBHOOK_TASKS_SERVICE_ACCOUNT=idenzy-eu-1-webhooks@idenzy-dev.iam.gserviceaccount.com
# WEBHOOK_DISPATCH_URL=https://workers-xxxx.a.run.app/internal/webhooks/dispatch
