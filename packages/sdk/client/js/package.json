{
  "name": "@idenzy/js",
  "version": "0.1.0",
  "description": "Idenzy's browser SDK: sign in with a password, a code, a magic link, OAuth or a passkey, and hold the session.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "passkeys",
    "oauth",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy.d.ts",
      "default": "./dist/idenzy.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@idenzy/core": "workspace:*",
    "@idenzy/protocol": "workspace:*",
    "zod": "catalog:sdk"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
