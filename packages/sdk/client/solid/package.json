{
  "name": "@idenzy/solid",
  "version": "0.2.0",
  "description": "Solid bindings for Idenzy: IdenzyProvider, and useSession, useUser and useIdenzy.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "solid",
    "solid-js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/solid"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-solid.d.ts",
      "default": "./dist/idenzy-solid.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@idenzy/sdk-conformance": "workspace:*",
    "jsdom": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
