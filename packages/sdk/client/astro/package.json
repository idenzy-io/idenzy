{
  "name": "@idenzy/astro",
  "version": "0.1.0",
  "description": "Astro middleware for Idenzy: the verified session on every request.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "astro",
    "ssr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/astro"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-astro.d.ts",
      "default": "./dist/idenzy-astro.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/node": "workspace:*"
  },
  "devDependencies": {
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
