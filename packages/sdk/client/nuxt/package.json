{
  "name": "@idenzy/nuxt",
  "version": "0.2.0",
  "description": "The Nuxt module for Idenzy: the Vue bindings, plus a server render seeded from the session cookie.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "nuxt",
    "nuxt-module"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/node": "workspace:*",
    "@idenzy/protocol": "workspace:*",
    "@idenzy/vue": "workspace:*",
    "@nuxt/kit": "catalog:sdk"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:",
    "jose": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
