# Copy to .env for local development. The apps load it with --env-file-if-exists, so a
# missing file is not an error; a missing *variable* is, because @idenzy/config parses
# the environment once at boot and refuses to start on a bad one.
#
# Nothing here is a secret. In staging and production these come from Secret Manager.

IDENZY_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# How many proxies of ours sit in front of the process, counted from the right of
# X-Forwarded-For. Rate limits are keyed on the address this picks, so 0 — trust nothing,
# use the socket address — is both the default and what a developer machine wants.
# Behind GCP's global load balancer this is 1, and each further hop adds one.
TRUSTED_PROXY_HOPS=0

# One port per service, because they run side by side and cookie mode needs the panel and
# the auth API to be same-site. On a laptop that is localhost, which ignores the port for
# cookie purposes, so `__Host-` cookies set by 3001 reach a page served from 3000. In
# production these are subdomains of one site: app.idenzy.io, auth.idenzy.io,
# api.idenzy.io (PROJECT.md 4.3).
#
# `PORT` is what each service reads; the three below are what `pnpm dev` gives them.
API_PORT=3001
WORKERS_PORT=3003

# Matches infra/docker/postgres-init and docker-compose.yml.
DATABASE_URL=postgres://idenzy:idenzy@localhost:5432/idenzy
VALKEY_URL=redis://localhost:6379

# The analytics store (ADR-0013). The runtime identity carries the row policies, the ingest one
# writes, the eraser deletes an erased user's rows, and the owner runs DDL. A deployment without these runs without analytics rather
# than failing, because nothing on the authentication path reads them.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=idenzy
CLICKHOUSE_USER=idenzy_app
CLICKHOUSE_INGEST_USER=idenzy_ingest
CLICKHOUSE_OWNER_USER=idenzy_owner
CLICKHOUSE_ERASER_USER=idenzy_eraser
CLICKHOUSE_PASSWORD=idenzy


# The `iss` claim and the base of the discovery document. Required, and deliberately not
# defaulted: a wrong issuer is accepted by every verifier told to expect it and rejected
# by every verifier that was not.
ISSUER_BASE_URL=http://localhost:3001

# Transactional email. Everything else about delivery has a working default; this is the
# envelope sender, and in development nothing is actually sent: LoggingEmailProvider
# prints the whole message, one-time code included, and refuses to exist anywhere else.
EMAIL_FROM_ADDRESS=no-reply@idenzy.io

# Amazon SES (PROJECT.md 11.1). Commented out because a developer machine sends nothing:
# with these unset, LoggingEmailProvider prints the whole message, one-time code included,
# and refuses to exist anywhere but development.
#
# All four or none. Three of them is a boot failure that names the one you missed, rather
# than a silent fallback to a transport that then refuses to construct.
#
# SES_CONFIGURATION_SET is not optional among them: bounces and complaints reach the
# suppression list only because a configuration set publishes them, and a message sent
# outside one is a hard bounce we never hear about — on a domain every project shares.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=idenzy-default

# Where those bounces and complaints come back (PROJECT.md 11.2 item 4). Read by the workers,
# which take the route's path from the URL so an SNS subscription's target and the route that
# answers it cannot drift apart.
#
# Both or neither, and the ARN is the half that matters. A valid SNS signature only proves a
# message came from *an* SNS topic — anybody can create one, subscribe this URL to it and
# publish through it, and every one of those carries a genuine AWS signature. Without the
# allowlist a stranger decides whose addresses we suppress, so a half-configured pair is no
# route at all rather than an open one.
# SES_EVENT_URL=https://workers-xxxx.a.run.app/internal/email/events
# SES_EVENT_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:idenzy-email-events

# The project our own dashboard signs in through: we run the panel on our own product
# (PROJECT.md 9.5), so a dashboard token is an ordinary Idenzy token and this is its `aud`.
# `pnpm db:seed` creates it with this fixed development id; production generates one.
DASHBOARD_PROJECT_ID=prj_00000000000040008000000000000002

# What the panel itself needs. Both are public by construction: a publishable key is meant
# to sit in a browser bundle, and the auth API's URL is printed in every token we sign.
# `NUXT_PUBLIC_` is how Nuxt overrides `runtimeConfig.public` from the environment.
#
# The key is minted once by `pnpm db:seed`, which prints it and cannot print it again —
# only its hash is stored. Paste it here.
NUXT_PUBLIC_IDENZY_PUBLISHABLE_KEY=
NUXT_PUBLIC_IDENZY_API_URL=http://localhost:3001

# The only origin the dashboard surface answers a browser at. Loopback is allowed in development
# by the CORS policy itself, so this is the production value even on a laptop.
DASHBOARD_ORIGIN=https://app.idenzy.io

# The webhook retry lane (ADR-0012). Commented out because a developer machine has no queue
# and does not need one: with these unset the worker sweeps the delivery table on its own
# interval, which is what actually guarantees a retry — Cloud Tasks only makes it punctual.
# Set all five or none; four of them is a boot failure rather than a silent fallback.
#
# The values come from `terraform output` (see infra/terraform/README.md).
# GCP_PROJECT_ID=idenzy-dev
# WEBHOOK_TASKS_LOCATION=us-central1
# WEBHOOK_TASKS_QUEUE_PREFIX=idenzy-webhooks
# WEBHOOK_TASKS_QUEUE_SHARDS=8
# WEBHOOK_TASKS_SERVICE_ACCOUNT=idenzy-webhooks@idenzy-dev.iam.gserviceaccount.com
# WEBHOOK_DISPATCH_URL=https://workers-xxxx.a.run.app/internal/webhooks/dispatch

# Stripe (PROJECT.md 5.1). Commented out because a developer machine charges nothing: with
# these unset the management API starts without a payment provider, the wallet screen says
# so, and nothing offers to take a card.
#
# All five or none. `stripeSettingsFrom` refuses a partial set and the process does not
# start, which is the same call the five Cloud Tasks variables make and for a sharper
# reason: four of five would boot and put a customer through a checkout whose webhook we
# cannot verify, which is money charged and no credit granted.
#
# Use test keys. `sk_test_` cannot reach a real card — Stripe refuses a live operation with
# a test key and the reverse — and a live key belongs in Secret Manager and nowhere else.
#
# STRIPE_CHECKOUT_*_URL is where Stripe sends the browser back, so it is the panel's own
# origin and route rather than this service's. Production is https://app.idenzy.io/...
#
# The webhook secret is per endpoint, not per account: the one Stripe shows when you create
# the endpoint is the only thing that verifies its signature, and an endpoint recreated
# gets a new one.
#
# STRIPE_API_VERSION has a default and is ours to pin. Stripe rolls object shapes per
# version, so letting the account default decide would change behaviour the day somebody
# upgrades it in a dashboard nobody here is watching.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/wallet?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/wallet?checkout=cancel
# STRIPE_API_VERSION=2026-08-26.dahlia
