{
  "name": "@idenzy/next",
  "version": "0.2.0",
  "description": "Next.js helpers for Idenzy: the session on the server, protected routes in middleware, and the React bindings.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "nextjs",
    "next",
    "react",
    "ssr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/next"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/node": "workspace:*",
    "@idenzy/protocol": "workspace:*",
    "@idenzy/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "jose": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
