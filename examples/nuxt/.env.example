# Copy this to .env and fill in your own project's values.
# Safe in a browser bundle. The secret key is not: keep that on a server.
NUXT_PUBLIC_IDENZY_PUBLISHABLE_KEY=pk_us1_replace_me
# Your auth domain. Cookie mode needs one that is same-site with your app.
NUXT_PUBLIC_IDENZY_API_URL=https://auth.idenzy.io
# Lets the server verify the cookie and seed the render. Public: it is the audience of every token we sign.
NUXT_PUBLIC_IDENZY_PROJECT_ID=
