# Supply-chain controls (PROJECT.md 7.6). Lifecycle scripts are OFF by default;
# packages that genuinely need a native build are allowlisted in package.json
# under pnpm.onlyBuiltDependencies and require reviewer sign-off to add.
ignore-scripts=true

# Strict linking: a package cannot import a dependency it has not declared.
node-linker=isolated
strict-peer-dependencies=true
auto-install-peers=false
resolution-mode=highest

# Reproducibility
prefer-frozen-lockfile=true
save-exact=true

engine-strict=true
