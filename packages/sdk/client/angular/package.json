{
  "name": "@idenzy/angular",
  "version": "0.1.0",
  "description": "Angular bindings for Idenzy: provideIdenzy and an injectable session.",
  "keywords": [
    "idenzy",
    "auth",
    "authentication",
    "angular"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenzy-io/idenzy.git",
    "directory": "packages/sdk/client/angular"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/idenzy-angular.d.ts",
      "default": "./dist/idenzy-angular.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0"
  },
  "dependencies": {
    "@idenzy/js": "workspace:*",
    "@idenzy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@idenzy/sdk-conformance": "workspace:*",
    "@angular/core": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
