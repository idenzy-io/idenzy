{
  "name": "@idenzy/management-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "node ../../tools/dev/src/serve.ts",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test:integration": "tsc -p tsconfig.json && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@idenzy/compliance": "workspace:*",
    "@idenzy/config": "workspace:*",
    "@idenzy/core": "workspace:*",
    "@idenzy/crypto": "workspace:*",
    "@idenzy/domain": "workspace:*",
    "@idenzy/node": "workspace:*",
    "@idenzy/observability": "workspace:*",
    "@idenzy/persistence": "workspace:*",
    "@idenzy/protocol": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@idenzy/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
